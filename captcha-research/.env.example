# Chave de teste (opcional; padrão já embutido)
NFE_CHAVE=

# Alternativa oficial: certificado ICP-Brasil convertido para PEM (nunca versionar)
NFE_CERT_PEM=
NFE_KEY_PEM=
# 1 = produção, 2 = homologação
NFE_TP_AMB=1
# Download XML/PDF (NFeDistribuicaoDFe): CNPJ/CPF do certificado (ator da NF-e) e cUF dele (ex.: 51 = MT)
NFE_CNPJ_CPF=
NFE_CUF_AUTOR=
# Bundle PEM com a cadeia ICP-Brasil (necessário para validar TLS da SEFAZ)
NFE_CA_BUNDLE=

# Browser Use (opcional, --ai)
ANTHROPIC_API_KEY=
BROWSER_USE_MODEL=claude-sonnet-5-5
