# Chave de teste do modo portal (opcional)
NFE_CHAVE=

# 1 = produção, 2 = homologação
NFE_TP_AMB=1
# Segundos entre requisições à SEFAZ
NFE_INTERVALO_SEG=2
# Bundle PEM com a cadeia ICP-Brasil (para validar o TLS da SEFAZ)
NFE_CA_BUNDLE=

# Senhas dos certificados: uma variável por cliente, com o nome definido em
# config/clientes.json -> "senha_env". Nunca coloque a senha no clientes.json.
CERT_SENHA_12345678000199=

# Browser Use (opcional, --ai)
ANTHROPIC_API_KEY=
BROWSER_USE_MODEL=claude-sonnet-5-5
